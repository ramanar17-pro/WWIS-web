---
interface Props {
  topic: string;
}

const { topic } = Astro.props;
---

<div class="glass coming-soon">
  <p class="mono-label">// {topic}</p>
  <h2>Details coming soon</h2>
  <p>
    We're finalizing accurate, up-to-date {topic} information for WWIS Trichy.
    Check back shortly, or contact the school office directly for current figures.
  </p>
</div>

<style>
  .coming-soon {
    max-width: 640px;
    margin: 80px auto;
    padding: 48px;
    text-align: center;
  }

  .coming-soon h2 {
    font-size: 28px;
    margin: 12px 0 16px;
  }

  .coming-soon p:last-child {
    color: var(--fog);
    margin: 0;
  }
</style>
