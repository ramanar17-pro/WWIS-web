---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import ComingSoon from '../components/ComingSoon.astro';
import TuitionCard from '../components/TuitionCard.astro';
import { getCanonicalOrg, tuitionToOffer } from '../lib/schema-mappers';

const entries = await getCollection('tuition');
const org = await getCanonicalOrg();
const offers = entries.map((entry) => tuitionToOffer(entry));
---

<BaseLayout
  title="Tuition & Fees"
  description="Tuition and fee information for Wisdom Wealth International School, Trichy — Cambridge curriculum, iPlay/iDiscover/iLead programs."
  currentNav="tuition"
  navVariant="on-gradient"
>
  <Fragment slot="head">
    {offers.map((offer) => <JsonLd data={{ '@context': 'https://schema.org', ...offer }} />)}
    <JsonLd data={{ '@context': 'https://schema.org', ...org }} />
  </Fragment>

  <div class="hero-band">
    <div class="hero-shapes" aria-hidden="true"></div>
    <div class="hero wrap">
      <div class="hero-copy">
        <p class="hero-eyebrow">Tuition &amp; Fees</p>
        <h1>What it costs to <span class="highlight">join WWIS Trichy</span></h1>
        <p class="hero-sub">Cambridge curriculum, Trichy — see what each program costs below.</p>
        <a href="#fees" class="cta-btn">See the fees ↓</a>
      </div>
      <figure class="hero-photo">
        <img src="/photos/tuition-hero.png" alt="Students and a teacher at WWIS Trichy" />
      </figure>
    </div>
  </div>

  <main class="wrap" id="fees">
    {
      entries.length === 0 ? (
        <ComingSoon topic="tuition" />
      ) : (
        <div class="grid">
          {entries.map((entry) => (
            <TuitionCard {...entry.data} />
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 24px 100px;
  }

  .hero-band {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--navy) 0%, var(--crimson) 55%, var(--orange) 100%);
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-shapes::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -100px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-shapes::after {
    content: '';
    position: absolute;
    bottom: -160px;
    left: 8%;
    width: 320px;
    height: 320px;
    border: 2px solid rgba(255, 255, 255, 0.14);
    border-radius: 64px;
    transform: rotate(20deg);
  }

  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    padding-top: 148px;
    padding-bottom: 88px;
  }

  .hero-eyebrow {
    font-family: 'Nunito Sans', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 14px;
  }

  .hero h1 {
    font-size: 44px;
    max-width: 480px;
    margin: 0;
    color: var(--white);
  }

  .hero .highlight {
    color: #ffe9b0;
  }

  .hero-sub {
    font-family: 'Nunito Sans', system-ui, sans-serif;
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
    max-width: 420px;
    margin: 16px 0 28px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--orange);
    color: var(--white);
    font-family: 'Nunito Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 28px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease;
  }

  .cta-btn:hover {
    transform: translateY(-3px);
  }

  .hero-photo {
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.3);
  }

  .hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 132px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
