---
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  currentNav?: string;
  navVariant?: 'light' | 'on-gradient';
}

const { title, description, currentNav, navVariant } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — WWIS Trichy</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Nunito+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <Nav current={currentNav} variant={navVariant} />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --white: #ffffff;
    --navy: #1b3b63;
    --crimson: #a91e5c;
    --orange: #f2941f;
    --slate: #6b7a8f;
    --crimson-soft: #fbe7ef;
    --navy-soft: #eaf0f7;
    --text: #1b3b63;
    --glass-fill: var(--white);
    --glass-border: rgba(27, 59, 99, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--white);
    color: var(--text);
    font-family: 'Nunito Sans', system-ui, sans-serif;
    line-height: 1.55;
  }

  h1,
  h2,
  h3 {
    font-family: 'Poppins', system-ui, sans-serif;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--navy);
  }

  .mono-label {
    font-family: 'Nunito Sans', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--crimson);
    font-weight: 700;
  }

  .glass {
    background: var(--glass-fill);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: 0 4px 16px rgba(27, 59, 99, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
